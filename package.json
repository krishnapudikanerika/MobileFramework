{
  "name": "mobileframework",
  "version": "1.0.0",
  "description": "Mobile Automation Framework using Appium, WebdriverIO and TypeScript",
  "main": "index.js",
  "scripts": {
    "mobile-smoke": "mocha -r ts-node/register tests/mobile/smoke.spec.ts --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false",
    "mobile-product": "mocha -r ts-node/register tests/mobile/productValidation.spec.ts --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false",
    "mobile-cart": "mocha -r ts-node/register tests/mobile/addToCart.spec.ts --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false",
    "mobile-login": "mocha -r ts-node/register tests/mobile/login.spec.ts --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false",
    "mobile-all":
    "mocha -r ts-node/register \"tests/mobile/**/*.spec.ts\"",
    "tv-smoke":
    "mocha -r ts-node/register tests/tv/tvSmoke.spec.ts",

    "tv-navigation":
    "mocha -r ts-node/register tests/tv/tvNavigation.spec.ts"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "mobile",
    "android",
    "typescript",
    "automation"
  ],
  "author": "Krishna Pudi",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^10.0.2",
    "allure-commandline": "^2.46.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "mocha": "^10.8.2",
    "mochawesome": "^7.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "webdriverio": "^10.0.2"
  }
}
