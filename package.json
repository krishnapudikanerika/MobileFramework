{
  "name": "mobileframework",
  "version": "1.0.0",
  "description": "Mobile Automation Framework using Appium, WebdriverIO and TypeScript",
  "main": "index.js",
  "scripts": {
    "mobile-smoke": "mocha -r ts-node/register tests/smoke/smoke.spec.ts --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false",

    "mobile-product": "mocha -r ts-node/register tests/regression/productValidation.spec.ts --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false",

    "mobile-cart": "mocha -r ts-node/register tests/regression/addToCart.spec.ts --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false",

    "mobile-login": "mocha -r ts-node/register tests/regression/login.spec.ts --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false",

    "mobile-all": "mocha -r ts-node/register \"tests/**/*.spec.ts\" --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mobile-report,json=true,html=false"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "mobile",
    "android",
    "typescript",
    "automation"
  ],
  "author": "Krishna Pudi",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^10.0.2",
    "allure-commandline": "^2.46.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "mocha": "^12.0.3",
    "mochawesome": "^7.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "webdriverio": "^10.0.2"
  }
}